# --- توکن ربات تلگرام (از @BotFather بگیرید) ---
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- آیدی عددی ادمین‌ها، با کاما جدا کنید ---
# آیدی عددی خود را می‌توانید از @userinfotoolsbot یا @getmy_id بگیرید
ADMIN_IDS=111111111,222222222

# --- یا به‌جای آیدی عددی، یوزرنیم ادمین‌ها (بدون @)، با کاما جدا کنید ---
# با اولین پیام این کاربران به ربات، به‌صورت خودکار ادمین می‌شوند
ADMIN_USERNAMES=SuportAdminQr

# --- اطلاعات کارت برای شارژ کارت‌به‌کارت کیف پول ---
CARD_NUMBER=6037-9912-3456-7890
CARD_HOLDER=نام صاحب کارت

# --- مسیر فایل دیتابیس SQLite ---
DB_PATH=barcood.db

# --- پروکسی (اختیاری): اگر اینترنت شما تلگرام را فیلتر می‌کند ---
# مثال: socks5://127.0.0.1:1080 یا http://127.0.0.1:8080
PROXY_URL=

# --- هدیه معرف به ازای اولین خرید زیرمجموعه (تومان) ---
REFERRAL_BONUS=20000

# --- حداقل مبلغ شارژ کیف پول (تومان) ---
MIN_CHARGE=10000
